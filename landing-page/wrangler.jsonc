{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker que serve tghservices.com.br e www.tghservices.com.br (landing page, /curriculo e /api/pedido).
  "name": "tghservices-manutencao",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Saída do `vite build` (a pasta public/ é copiada para dentro dela).
    "directory": "./dist",
    "binding": "ASSETS",
    // O Worker decide o status e os cabeçalhos de cada rota, então roda antes dos arquivos.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "tghservices.com.br", "custom_domain": true },
    { "pattern": "www.tghservices.com.br", "custom_domain": true }
  ],
  // Formulário de pedido: o Worker manda o pedido por e-mail (Cloudflare Email Service).
  // Grátis em qualquer plano porque o destino é um endereço verificado no Email Routing
  // da conta. O remetente (PEDIDO_DE) precisa ser do domínio que está no Email Routing.
  "send_email": [{ "name": "EMAIL", "destination_address": "tghservices.psa@gmail.com" }],
  "vars": {
    "PEDIDO_PARA": "tghservices.psa@gmail.com",
    "PEDIDO_DE": "site@tghservices.com.br",
    "PEDIDO_NOME": "Site TGH Services",
    // Painel /admin: só estes e-mails entram (separados por vírgula). O login é feito
    // pelo Cloudflare Access; o Worker confere o token dele com o domínio e o AUD abaixo.
    "ADMIN_EMAILS": "tghservices.psa@gmail.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // Cards de projetos (criados e editados no /admin). Prévia e site oficial usam o mesmo banco.
  "d1_databases": [{ "binding": "DB", "database_name": "tghservices-site", "database_id": "c7922938-8f87-4a51-8233-fe162fe8dd0b", "migrations_dir": "migrations" }],
  // Imagens enviadas pelo /admin, servidas em /midia/*.
  "r2_buckets": [{ "binding": "IMAGENS", "bucket_name": "tghservices-site-imagens" }],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
